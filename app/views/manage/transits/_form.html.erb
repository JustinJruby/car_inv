<% messages = (transit.errors.full_messages + car.errors.full_messages).uniq %>
<% if messages.any? %>
  <div role="alert" class="mb-6 rounded-lg bg-red-50 px-4 py-3 text-sm text-red-800 ring-1 ring-inset ring-red-600/20">
    <p class="font-semibold">Please fix the following:</p>
    <ul class="mt-2 list-disc space-y-1 pl-5">
      <% messages.each do |message| %>
        <li><%= message %></li>
      <% end %>
    </ul>
  </div>
<% end %>

<%= form_with url: manage_transits_path, scope: :transit, class: "space-y-8" do |f| %>
  <section>
    <h2 class="section-title mb-5">Car</h2>
    <div class="grid gap-5 sm:grid-cols-2">
      <div>
        <%= f.label :vin, "VIN", class: "label" %>
        <%= f.text_field :vin, value: car.vin, maxlength: 17, class: "input font-mono uppercase", required: true %>
      </div>
      <div>
        <%= f.label :dealership_id, "Destination dealership", class: "label" %>
        <%= f.select :dealership_id, Dealership.order(:name).map { |d| [d.name, d.id] }, { selected: transit.dealership_id }, class: "input" %>
      </div>
      <div>
        <%= f.label :year, class: "label" %>
        <%= f.number_field :year, value: car.year, class: "input", required: true %>
      </div>
      <div>
        <%= f.label :make, class: "label" %>
        <%= f.text_field :make, value: car.make, class: "input", required: true %>
      </div>
      <div>
        <%= f.label :model, class: "label" %>
        <%= f.text_field :model, value: car.model, class: "input", required: true %>
      </div>
    </div>
  </section>

  <section>
    <h2 class="section-title mb-5">Transit</h2>
    <div class="grid gap-5 sm:grid-cols-2">
      <div class="sm:col-span-2">
        <%= f.label :origin, "Coming from", class: "label" %>
        <%= f.text_field :origin, value: transit.origin, maxlength: 120, class: "input", placeholder: "e.g. Auction, Phoenix" %>
      </div>
      <div>
        <%= f.label :expected_arrival_on, "Expected arrival", class: "label" %>
        <%= f.date_field :expected_arrival_on, value: transit.expected_arrival_on, class: "input" %>
      </div>
    </div>
  </section>

  <div class="flex items-center justify-end gap-3">
    <%= link_to "Cancel", manage_transits_path, class: "btn-secondary" %>
    <%= f.submit "Record car in transit", class: "btn-primary" %>
  </div>
<% end %>

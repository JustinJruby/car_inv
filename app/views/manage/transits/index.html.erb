<% content_for :title, "Cars in transit" %>

<div class="mb-6 flex flex-wrap items-end justify-between gap-4">
  <div>
    <h1 class="text-2xl font-bold tracking-tight text-slate-900">Cars in transit</h1>
    <p class="mt-1 text-sm text-slate-500">Open transits for all dealerships, earliest expected arrival first.</p>
  </div>
  <%= link_to "Record a car", new_manage_transit_path, class: "btn-primary" %>
</div>

<% if @transits.empty? %>
  <div class="card px-6 py-16 text-center">
    <p class="text-base font-medium text-slate-900">No cars are in transit.</p>
    <p class="mt-1 text-sm text-slate-500">Record a car when you know it is on its way.</p>
  </div>
<% else %>
  <div class="card overflow-x-auto">
    <table class="min-w-full divide-y divide-slate-200 text-sm">
      <thead class="bg-slate-50 text-left text-xs font-semibold uppercase tracking-wide text-slate-500">
        <tr>
          <th scope="col" class="px-6 py-3">Car</th>
          <th scope="col" class="px-6 py-3">VIN</th>
          <th scope="col" class="px-6 py-3">Origin</th>
          <th scope="col" class="px-6 py-3">Expected</th>
          <th scope="col" class="px-6 py-3">Flags</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-slate-100">
        <% @transits.each do |transit| %>
          <tr data-transit="<%= transit.id %>" class="hover:bg-slate-50">
            <td class="px-6 py-4 font-medium">
              <%= link_to "#{transit.car.year} #{transit.car.make} #{transit.car.model}", manage_transit_path(transit), class: "text-indigo-600 hover:text-indigo-800" %>
            </td>
            <td class="whitespace-nowrap px-6 py-4 font-mono text-slate-700"><%= transit.car.vin %></td>
            <td class="px-6 py-4 text-slate-700"><%= transit.origin %></td>
            <td class="whitespace-nowrap px-6 py-4 text-slate-700"><%= transit.expected_arrival_on.strftime("%b %-d, %Y") %></td>
            <td class="px-6 py-4">
              <div class="flex flex-wrap gap-2">
                <% if transit.overdue? %>
                  <span data-overdue="true" class="badge bg-red-50 text-red-700 ring-1 ring-inset ring-red-600/20">Overdue</span>
                <% else %>
                  <span class="badge bg-sky-50 text-sky-700 ring-1 ring-inset ring-sky-600/20">In transit</span>
                <% end %>
                <% if transit.pre_sell? %>
                  <span class="badge bg-amber-50 text-amber-800 ring-1 ring-inset ring-amber-600/20">Pre-sell</span>
                <% end %>
              </div>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
<% end %>

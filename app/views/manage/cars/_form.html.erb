<%= form_with model: [:manage, car], class: "space-y-6" do |f| %>
  <%= f.hidden_field :lock_version %>

  <% if car.errors.any? %>
    <div role="alert" class="rounded-lg bg-red-50 px-4 py-3 text-sm text-red-800 ring-1 ring-inset ring-red-600/20">
      <p class="font-semibold">Please fix the following:</p>
      <ul class="mt-2 list-disc space-y-1 pl-5">
        <% car.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <section class="card p-6">
    <h2 class="section-title mb-5">Vehicle</h2>
    <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
      <div>
        <%= f.label :dealership_id, "Dealership", class: "label" %>
        <%= f.collection_select :dealership_id, Dealership.order(:name), :id, :name, { prompt: "Choose one" }, class: "input" %>
      </div>
      <div>
        <%= f.label :make, class: "label" %>
        <%= f.text_field :make, required: true, class: "input" %>
      </div>
      <div>
        <%= f.label :model, class: "label" %>
        <%= f.text_field :model, required: true, class: "input" %>
      </div>
      <div>
        <%= f.label :year, class: "label" %>
        <%= f.number_field :year, required: true, class: "input" %>
      </div>
      <div>
        <%= f.label :vin, "VIN", class: "label" %>
        <%= f.text_field :vin, required: true, maxlength: 17, class: "input font-mono uppercase" %>
      </div>
      <div>
        <%= f.label :mileage, class: "label" %>
        <%= f.number_field :mileage, min: 0, class: "input" %>
      </div>
    </div>
  </section>

  <section class="card p-6">
    <h2 class="section-title mb-5">Pricing &amp; status</h2>
    <div class="grid gap-5 sm:grid-cols-2">
      <div>
        <%= f.label :asking_price, "Asking price ($)", class: "label" %>
        <%= f.number_field :asking_price, step: "0.01", min: 0.01, required: true, class: "input" %>
      </div>
      <div>
        <%= f.label :status, class: "label" %>
        <%= f.select :status, Car.statuses.keys.map { |s| [s.humanize, s] }, {}, class: "input" %>
      </div>
    </div>
  </section>

  <section class="card p-6">
    <h2 class="section-title mb-5">Features &amp; description</h2>
    <div class="space-y-5">
      <div>
        <%= f.label :feature_names, "Features (comma separated, e.g. AWD, leather seats)", class: "label" %>
        <%= f.text_field :feature_names, class: "input" %>
      </div>
      <div>
        <%= f.label :description, class: "label" %>
        <%= f.rich_text_area :description %>
      </div>
    </div>
  </section>

  <section class="card p-6">
    <h2 class="section-title mb-5">Photos</h2>
    <%= f.label :new_photos, "Add photos", class: "label" %>
    <%= f.file_field :new_photos, multiple: true, accept: "image/jpeg,image/png,image/webp",
          class: "block w-full cursor-pointer rounded-lg border border-dashed border-slate-300 bg-slate-50 p-4 text-sm text-slate-600 file:mr-4 file:cursor-pointer file:rounded-md file:border-0 file:bg-indigo-600 file:px-4 file:py-2 file:text-sm file:font-semibold file:text-white hover:file:bg-indigo-700" %>
  </section>

  <section class="card p-6">
    <h2 class="section-title mb-1">Staff contact</h2>
    <p class="mb-5 text-xs text-slate-500">Private: shown to staff only.</p>
    <div class="grid gap-5 sm:grid-cols-3">
      <div>
        <%= f.label :contact_name, class: "label" %>
        <%= f.text_field :contact_name, class: "input" %>
      </div>
      <div>
        <%= f.label :contact_phone, class: "label" %>
        <%= f.telephone_field :contact_phone, class: "input" %>
      </div>
      <div>
        <%= f.label :contact_email, class: "label" %>
        <%= f.email_field :contact_email, class: "input" %>
      </div>
    </div>
  </section>

  <div class="flex justify-end">
    <%= f.submit class: "btn-primary" %>
  </div>
<% end %>

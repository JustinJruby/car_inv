<%# Cached per car: the key includes updated_at, so any edit (including tags and photos) refreshes it (SC-004). %>
<% cache car do %>
  <li>
    <%= link_to "#{car.year} #{car.make} #{car.model}", car_path(car) %>
    &mdash; <%= number_to_currency(car.asking_price) %>
    <% if car.features.any? %>
      (<%= car.features.map { |feature| feature.name }.join(", ") %>)
    <% end %>
  </li>
<% end %>

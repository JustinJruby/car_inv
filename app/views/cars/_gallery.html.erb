<% if car.photos.attached? %>
  <ul class="gallery grid grid-cols-2 gap-3 sm:grid-cols-3">
    <% car.photos.each do |photo| %>
      <li class="overflow-hidden rounded-xl bg-slate-100 ring-1 ring-slate-200">
        <%= image_tag photo, alt: "#{car.year} #{car.make} #{car.model}", class: "aspect-4/3 h-full w-full object-cover" %>
      </li>
    <% end %>
  </ul>
<% end %>

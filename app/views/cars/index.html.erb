<% content_for :title, "Available cars" %>
<%= turbo_stream_from "cars" %>

<div class="mb-8">
  <h1 class="text-3xl font-bold tracking-tight text-slate-900">Available cars</h1>
  <p class="mt-1 text-sm text-slate-500">Browse the current inventory and narrow it down.</p>
</div>

<%= form_with url: cars_path, method: :get, data: { turbo_frame: "car_results" }, class: "card mb-8 p-5 sm:p-6" do |f| %>
  <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-6">
    <div class="lg:col-span-2">
      <%= f.label :make, class: "label" %>
      <%= f.text_field :make, value: params[:make], class: "input" %>
    </div>
    <div>
      <%= f.label :min_price, "Min price ($)", class: "label" %>
      <%= f.number_field :min_price, value: params[:min_price], min: 0, class: "input" %>
    </div>
    <div>
      <%= f.label :max_price, "Max price ($)", class: "label" %>
      <%= f.number_field :max_price, value: params[:max_price], min: 0, class: "input" %>
    </div>
    <div>
      <%= f.label :min_year, "Min year", class: "label" %>
      <%= f.number_field :min_year, value: params[:min_year], class: "input" %>
    </div>
    <div>
      <%= f.label :max_year, "Max year", class: "label" %>
      <%= f.number_field :max_year, value: params[:max_year], class: "input" %>
    </div>
    <div class="lg:col-span-2">
      <%= f.label :feature, class: "label" %>
      <%= f.text_field :feature, value: params[:feature], class: "input" %>
    </div>
  </div>
  <div class="mt-5 flex justify-end">
    <%= f.submit "Search", class: "btn-primary" %>
  </div>
<% end %>

<%= turbo_frame_tag "car_results" do %>
  <%= render "results", cars: @cars %>
<% end %>
